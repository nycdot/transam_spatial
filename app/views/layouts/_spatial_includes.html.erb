<% if Rails.application.config.transam_spatial_map_control == "leaflet" %>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" />
  <%= javascript_include_tag "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js" %>

<% elsif  Rails.application.config.transam_spatial_map_control == "mapbox" %>

  <link href='https://api.tiles.mapbox.com/mapbox.js/v2.1.4/mapbox.css' rel='stylesheet' />
  <script src='https://api.tiles.mapbox.com/mapbox.js/v2.1.4/mapbox.js'></script>
<% end %>

<% if Rails.application.config.transam_spatial_map_options.include? "esri" %>
  <%= javascript_include_tag "https://cdnjs.cloudflare.com/ajax/libs/esri-leaflet/1.0.4/esri-leaflet.js" %>
<% end %>

<% if Rails.application.config.transam_spatial_map_options.include? "draw" %>
  <link rel='stylesheet' href='https://unpkg.com/leaflet-draw@1.0.4/dist/leaflet.draw.css'  />
  <%= javascript_include_tag "https://unpkg.com/leaflet-draw@1.0.4/dist/leaflet.draw.js" %>
<% end %>

<% if Rails.application.config.transam_spatial_map_options.include? "locate" %>
  <link rel='stylesheet' href='https://cdn.jsdelivr.net/npm/leaflet.locatecontrol@0.83.1/dist/L.Control.Locate.min.css'  />
  <%= javascript_include_tag "https://cdn.jsdelivr.net/npm/leaflet.locatecontrol@0.83.1/dist/L.Control.Locate.min.js" %>
<% end %>
