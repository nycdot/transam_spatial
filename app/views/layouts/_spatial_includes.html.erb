<% if Rails.application.config.transam_spatial_map_control == "leaflet" %>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous" />
  <%= javascript_include_tag "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js", integrity: "sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=", crossorigin: "anonymous" %>

<% elsif  Rails.application.config.transam_spatial_map_control == "mapbox" %>

  <link href='https://api.tiles.mapbox.com/mapbox.js/v2.1.4/mapbox.css' rel='stylesheet' integrity="sha256-Xb5XVMB+HW4if0bAD9QsphpB4Fv2U8eJ8OGxBb96naI=" crossorigin="anonymous" />
  <script src='https://api.tiles.mapbox.com/mapbox.js/v2.1.4/mapbox.js'  integrity="sha256-Yw8eN4CzOhTtZYbcyhpsT0Wbwweq00JyrpQ9sHzGlQc=" crossorigin="anonymous" ></script>
<% end %>

<% if Rails.application.config.transam_spatial_map_options.include? "esri" %>
  <%= javascript_include_tag "https://cdnjs.cloudflare.com/ajax/libs/esri-leaflet/1.0.4/esri-leaflet.js", integrity: "sha256-f07pIZhBKuS7locVZbGsoORimR6gjVAfi4K/qXbhppo=", crossorigin: "anonymous" %>
<% end %>

<% if Rails.application.config.transam_spatial_map_options.include? "draw" %>
  <link rel='stylesheet' href='https://unpkg.com/leaflet-draw@1.0.4/dist/leaflet.draw.css' integrity="sha256-XzD3RpaHPv7lzX9qt+2n1j5cWj48O24KsgaGYpKN8x8=" crossorigin="anonymous" />
  <%= javascript_include_tag "https://unpkg.com/leaflet-draw@1.0.4/dist/leaflet.draw.js", integrity: "sha256-siofc4Uwjlra3YWkwthOn8Uj69cNN4aMug/iOHNiRgs=", crossorigin: "anonymous" %>
<% end %>

<% if Rails.application.config.transam_spatial_map_options.include? "locate" %>
  <link rel='stylesheet' href='https://cdn.jsdelivr.net/npm/leaflet.locatecontrol@0.83.1/dist/L.Control.Locate.min.css' integrity="sha256-3PXa1eIJsM3owBQDkWnv+w0ikd9zv9OJOOy2asvgGfA=" crossorigin="anonymous" />
  <%= javascript_include_tag "https://cdn.jsdelivr.net/npm/leaflet.locatecontrol@0.83.1/dist/L.Control.Locate.min.js", integrity: "sha256-77Du33ZJbZpMVEDbUn+/PZnZsQMDgOYtXSoVln9T37M=", crossorigin: "anonymous" %>
<% end %>
